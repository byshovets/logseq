+(defonce ^:private *durability-flush-installed? (atom false))
+(defn install-durability-flush!
+  "Persist the block being edited when the page is hidden or unloaded, so an
+  accidental tab close / navigation doesn't drop in-flight text. This is
+  best-effort: the transact is an async worker round-trip that may not finish
+  before teardown, so it is backed by the synchronous localStorage recovery
+  buffer (see stash-recovery! / restore-unsaved-edit!)."
+  []
+  (when-not @*durability-flush-installed?
+    (reset! *durability-flush-installed? true)
+    (let [flush! (fn [] (save-current-block! {:skip-properties? true}))]
+      (.addEventListener js/document "visibilitychange"
+                         (fn [] (when (= "hidden" (.-visibilityState js/document)) (flush!))))
+      (.addEventListener js/window "pagehide" (fn [] (flush!))))))
+
+(defn restore-unsaved-edit!
+  "On boot, re-apply any in-flight edit value that was stashed before a crash and
+  never made it into the graph. Idempotent: clears the buffer once reconciled."
+  [repo]
+  (-> (p/let [raw (js/localStorage.getItem recovery-key)
+              {stash-repo :repo uuid-str :uuid value :value} (when raw (edn/read-string raw))]
+        (when (and raw (= stash-repo repo) (string? uuid-str) (string? value))
+          ;; DB graphs lazy-load blocks, so page the block in before applying.
+          (p/let [_ (db-async/<get-block repo (uuid uuid-str) {:children? false})
+                  block (db/entity [:block/uuid (uuid uuid-str)])]
+            (when (and block
+                       (not= (string/trim (or (:block/title block) "")) (string/trim value)))
+              (save-block-aux! block value {:skip-properties? true})))))
+      (p/finally (fn [_ _] (clear-recovery!)))
+      (p/catch (fn [e] (log/error :restore-unsaved-edit-failed e)))))
+
 (defn- start-of-new-word?
   [input pos]
   (contains? #{" " "\t"} (get (.-value input) (- pos 2))))
