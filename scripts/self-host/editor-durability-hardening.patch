+(def ^:private recovery-key "logseq-editor-recovery")
+(defn- stash-recovery!
+  "Synchronously persist the in-flight edit value to localStorage so a hard crash
+  or accidental close before the block is transacted doesn't lose it."
+  [repo block value]
+  (when-let [uuid (:block/uuid block)]
+    (js/localStorage.setItem recovery-key
+                             (pr-str {:repo repo :uuid (str uuid) :value value}))))
+(defn clear-recovery! [] (js/localStorage.removeItem recovery-key))
+(defn- clear-recovery-if-saved!
+  "Drop the stash once a save for its exact block + value is issued, so a stale
+  stash can't outlive a successful save and later revert newer edits made
+  through sync or another tab."
+  [block value]
+  (try
+    (when-let [raw (js/localStorage.getItem recovery-key)]
+      (let [{uuid-str :uuid stashed :value} (edn/read-string raw)]
+        (when (and (= uuid-str (str (:block/uuid block)))
+                   (= stashed value))
+          (clear-recovery!))))
+    (catch :default _ (clear-recovery!))))
+
 (defn save-block-aux!
